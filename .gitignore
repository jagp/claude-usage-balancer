# Global ignore for things that should NEVER be committed in ANY repo.
# Wire it up once (machine-local):
#   git config --global core.excludesFile "<path-to-this-file>"

# Tier-1 local config
.env
.env.*.local
*.local.json
.claude/settings.local.json

# Secrets
*.key
*.pfx
*.pem
secrets.*

# OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store
*~
*.swp
.idea/
*.code-workspace

# --- dev-strap ---
omnilog.md.historic
# ado task board is git-ignored working state (regenerable, not a tracked artifact)
*.ado
.claude/task.ado
