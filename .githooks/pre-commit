#!/usr/bin/env sh
# Pre-commit gate for claude-usage-balancer.
# Lint/tests are customized to this project's stack (dev-strap PowerShell harness).
#   Enabled per-clone via: git config core.hooksPath .githooks
set -eu

ps=powershell
if command -v pwsh >/dev/null 2>&1; then ps=pwsh; fi

if [ -f ./PSScriptAnalyzerSettings.psd1 ]; then
  echo "[pre-commit] PSScriptAnalyzer..."
  "$ps" -NoProfile -NonInteractive -Command "\$i = @(); foreach (\$p in 'src','tests') { if (Test-Path \$p) { \$i += Invoke-ScriptAnalyzer -Path \$p -Recurse -Settings ./PSScriptAnalyzerSettings.psd1 } }; if (\$i) { \$i | Format-Table -AutoSize | Out-String | Write-Host; exit 1 }"
fi

# dev-strap uses an atomic run-all.ps1 harness (each test exits 0=pass/1=fail), not Pester.
if [ -f ./tests/run-all.ps1 ]; then
  echo "[pre-commit] tests/run-all.ps1..."
  "$ps" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./tests/run-all.ps1
fi

echo "[pre-commit] OK"
