# Base line-ending normalization. Use as a project .gitattributes or point
# core.attributesFile here globally.
* text=auto eol=lf

*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

*.sh        text eol=lf
.githooks/* text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.gif binary
